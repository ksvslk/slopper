<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- This is our custom view that draws the draggable rectangle -->
    <com.indrek.slopper.service.SelectionView
        android:id="@+id/selection_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Slim vertical button column on the right -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_post"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_tone"
            android:text="🍒 Post"
            android:textColor="#333333"
            android:textSize="12sp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            android:elevation="3dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_question"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_tone"
            android:text="🧐 Question"
            android:textColor="#333333"
            android:textSize="12sp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            android:elevation="3dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_answer"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_tone"
            android:text="✓ Answer"
            android:textColor="#333333"
            android:textSize="12sp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            android:elevation="3dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_emphatic"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_tone"
            android:text="💪 Emphatic"
            android:textColor="#333333"
            android:textSize="12sp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            android:elevation="3dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_smart"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_tone"
            android:text="🧠 Smart"
            android:textColor="#333333"
            android:textSize="12sp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            android:elevation="3dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_funny"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_tone"
            android:text="😄 Satirical"
            android:textColor="#333333"
            android:textSize="12sp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            android:elevation="3dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_conflicting"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_tone"
            android:text="⚡ Conflict"
            android:textColor="#333333"
            android:textSize="12sp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            android:elevation="3dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_positive"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_tone"
            android:text="🌊 Deep"
            android:textColor="#333333"
            android:textSize="12sp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            android:elevation="3dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_shocked"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_tone"
            android:text="🤯 Shocked"
            android:textColor="#333333"
            android:textSize="12sp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            android:elevation="3dp" />

        <!-- Cancel Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancel"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:background="@drawable/button_cancel"
            android:text="✕ Cancel"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:gravity="center"
            android:elevation="4dp" />

    </LinearLayout>

</FrameLayout>